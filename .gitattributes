# Normalize line endings across platforms.
* text=auto eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf

# The Gradle wrapper script MUST stay LF to run on macOS/Linux.
gradlew text eol=lf

# Binary assets — never touch line endings.
*.jar binary
*.png binary
*.jpg binary
*.wav binary
*.ico binary
